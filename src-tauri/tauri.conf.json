{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "allowDowngrades": true,
      "wix": {
        "language": "en-US",
        "template": null
      }
    },
    "longDescription": "PhotoClove - A modern photo viewer and manager",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "models/*.onnx"
    ],
    "shortDescription": "PhotoClove - Photo viewer and manager"
  },
  "productName": "PhotoClove",
  "mainBinaryName": "PhotoClove",
  "version": "0.0.1",
  "identifier": "ktat.photoclove",
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 1200,
        "resizable": true,
        "title": "PhotoClove",
        "width": 1600,
        "useHttpsScheme": true,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**",
          "**/.photoclove/**",
          "**/.photoclove_trash/**",
          "**/.cache/**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  }
}
